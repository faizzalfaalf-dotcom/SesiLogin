<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== KEPALA HALAMAN: PROFIL ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#16213E"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/desc_avatar"
                android:src="@drawable/ic_profil" />

            <TextView
                android:id="@+id/tvNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#C7D2DC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvBadgeSesi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#1F3B2E"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/badge_sesi_aktif"
                android:textColor="#9BE8BF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===== KARTU WAKTU LOGIN ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_terakhir_masuk"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvWaktu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#16213E"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== DAFTAR MENU ===== -->
        <TextView
            android:id="@+id/tvEditProfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:text="👤  Edit Profil / Pilih Avatar"
            android:textColor="#334155" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:text="🔔  Notifikasi"
            android:textColor="#334155" />

        <TextView
            android:id="@+id/tvPengaturanSandi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:text="⚙  Pengaturan / Ganti Sandi"
            android:textColor="#334155" />

        <!-- ===== TOMBOL KELUAR ===== -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/btn_keluar" />
    </LinearLayout>
</ScrollView>